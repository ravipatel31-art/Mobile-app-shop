# Copy to .env for local overrides. When you run `eval $(floci env)` these
# AWS_* values are usually set for you by Floci — you only need to set the
# app-specific names and the JWT secret.

# --- AWS / Floci ---
# Floci sets AWS_ENDPOINT_URL via `eval $(floci env)`. Leave unset to hit real AWS.
AWS_ENDPOINT_URL=http://localhost:4566
AWS_REGION=us-east-1
# Floci accepts any credentials; boto3 just needs them to be present.
AWS_ACCESS_KEY_ID=floci
AWS_SECRET_ACCESS_KEY=floci

# --- Resource names ---
MENU_TABLE=menu_items
ORDERS_TABLE=orders
ADMINS_TABLE=admins
ORDER_DATE_INDEX=order_date-index
IMAGES_BUCKET=cafe-menu-images

# --- Auth ---
JWT_SECRET=change-me-in-production
JWT_TTL_HOURS=12

# --- Seed admin account (used by scripts/seed.py) ---
SEED_ADMIN_USER=owner
SEED_ADMIN_PASSWORD=cafe123

# --- AI recommendations (local Ollama) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_TIMEOUT_S=25
RECOMMEND_LIMIT=3
RECOMMEND_CACHE_TTL=120
POPULAR_DAYS=7
